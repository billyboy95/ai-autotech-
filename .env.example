NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

CRM_PASSWORD=change-me-company-crm-password
CRM_FORM_SECRET=optional-shared-secret-for-marketing-form

# Agency logins use Supabase Auth (Authentication → Users) plus a memberships row.
# /command-centre and /agency require that session whenever these Supabase keys are set.
# Without the keys, the app renders fixture data for CI and local smoke tests.
# See docs/agency-owner-setup.md and supabase/owner-bootstrap.sql.
#
# Lock-out safety. Comma-separated emails. On first login, an address in this list
# that has no membership is attached as agency_owner of the AI AutoTech organisation.
# Idempotent and server-side (service role). It does not change an existing membership
# and it does not delete anything. When this is unset or blank, the app uses
# billyfaber06@gmail.com.
OWNER_EMAILS=billyfaber06@gmail.com

# Social buttons on /login. Comma-separated Supabase Auth provider ids.
# A button is shown only when it is listed here and enabled in the dashboard.
# Google stays first. Leave this blank to hide every social button. Email and the
# magic link still work. Supported ids: google, facebook, github, apple, azure,
# linkedin_oidc, x, discord. `twitter` is accepted as an alias for `x`.
# Create each provider app, then paste its client id and secret at
# https://supabase.com/dashboard/project/fnysxlswzufdnlbhndxc/auth/providers
# Do not put a provider client secret in this file. See docs/agency-owner-setup.md.
NEXT_PUBLIC_AUTH_PROVIDERS=

NEXT_PUBLIC_SITE_URL=https://ai-autotech.co.za
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
NEXT_PUBLIC_CLARITY_PROJECT_ID=xxxxxxxxxx
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/ai-autotech/discovery
NEXT_PUBLIC_WHATSAPP_NUMBER=27000000000

STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxx

# Billing. Leave BILLING_SANDBOX unset until PayFast sandbox keys exist.
# Checkout posts only to sandbox.payfast.co.za, and only when the merchant id is 10000100.
# Do not put a live PayFast, Paystack, or Yoco key here. Ad-hoc charges are not sent.
BILLING_SANDBOX=false
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Optional. Lets a signed-in admin record a mocked ITN on a production deploy. Leave unset.
BILLING_ALLOW_MOCK_ITN=

# Automation. Leave AUTOMATION_SEND_ENABLED unset or false until a provider is configured.
# With it false, follow-ups stay in the Outbox and nothing is delivered to leads.
AUTOMATION_SEND_ENABLED=false
CRON_SECRET=generate-a-long-random-string
AUTOMATION_WEBHOOK_SECRET=generate-a-long-random-string
# Optional. If set, GET /api/automation/summary requires Authorization: Bearer <token>
AUTOMATION_SUMMARY_TOKEN=
RESEND_API_KEY=
RESEND_FROM=AI AutoTech <billy@aiautotech.co.za>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0
# SMS. Prefer a per-workspace connection (Settings → Channels). Env vars are only the source for
# scripts/migrate-channel-credentials.mjs, which copies them into Vault for the AI AutoTech workspace.
# The script prints identifiers, never secret values, and does not turn sending on.
SMSPORTAL_CLIENT_ID=
SMSPORTAL_API_SECRET=
SMSPORTAL_SENDER_ID=
SMSPORTAL_WEBHOOK_SECRET=
# Legacy env fallback when no connection row exists. First match wins: BulkSMS, then Clickatell, then Twilio.
BULKSMS_TOKEN_ID=
BULKSMS_TOKEN_SECRET=
BULKSMS_USERNAME=
BULKSMS_PASSWORD=
CLICKATELL_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Social publishing. Used only when AUTOMATION_SEND_ENABLED=true.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v21.0
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_VERSION=202502
# Conversation AI drafts. Leave the key empty until a provider is chosen.
# AI_REPLY_BASE_URL is any OpenAI-compatible /v1 root. AI_REPLY_MODEL defaults to gpt-4o-mini.
# Drafts stay off until ai_reply_settings.enabled is turned on for a workspace.
# The cron at /api/cron/ai-replies does nothing unless AI_REPLY_CRON_ENABLED is the string true.
# It still requires CRON_SECRET in production, and it will not queue while sending is off
# or while require_human_before_send is true (the default). Do not put a real key here.
AI_REPLY_API_KEY=
AI_REPLY_BASE_URL=
AI_REPLY_MODEL=
AI_REPLY_CRON_ENABLED=

# Bot assistant on the command-centre home. Off unless this is the string true.
# It also stays off when AI_REPLY_API_KEY is empty. The assistant proposes actions
# for a person to confirm. It does not send, and it does not turn sending on.
# The Lead Agent at /command-centre/lead-agent asks every business and per-agent
# question, then records a sandbox trial with start_recommended_sandbox_team.
# It does not charge, connect accounts, or import contacts. /command-centre/setup
# remains the shorter form. Both recommend a team with rules only.
# When both this flag and AI_REPLY_API_KEY are set, the model may rewrite the
# explanation sentences. It does not choose agents, prices, or sending.
BOT_ASSISTANT_ENABLED=

# Home assistant on /command-centre and /command-centre/assistant.
# Unset means fixture-only: the chat can look up the fixture, summarise, and
# show a draft, but it does not store that draft. Set this to the string true
# only after step 25, and only to store sandbox drafts. Drafts stay drafts.
# This does not send, charge, or turn sending_enabled on.
# See docs/home-chat.md.
HOME_CHAT_ENABLED=

# Campaign dry run on /command-centre/campaigns.
# Unset means fixture-only: the panel shows a sample report and does not store it.
# Set this to the string true only after step 26, and only to store sandbox reports.
# Send now and go live stay refused. Nothing is queued or charged.
# See docs/campaign-dry-run.md.
CAMPAIGN_DRY_RUN_ENABLED=

# WhatsApp (Meta Cloud) and Facebook / Instagram connect stubs.
# Unset means the badges render and Connect opens the stub page, but nothing is stored.
# Set this to the string true only after step 26. No OAuth runs and no key is stored.
# Send test is refused while provider keys are missing.
META_CONNECT_STUB_ENABLED=

# Sandbox campaign CSV dry-load on /command-centre/campaigns.
# Unset means fixture-only: the panel shows imported and skipped counts and does not store them.
# Set this to the string true only after step 27, and only to store a draft campaign.
# Missing consent is skipped. Send now and go live stay refused. Nothing is queued or charged.
# See docs/campaign-csv-import.md.
CAMPAIGN_CSV_IMPORT_ENABLED=

# Email (Resend or SMTP) and SMS (SMSPortal, BulkSMS, Clickatell placeholders) connect stubs.
# Unset means the badges render and Connect opens the stub page, but nothing is stored.
# Set this to the string true only after step 27. No OAuth runs and no key is stored.
# Send test is refused while provider keys are missing.
EMAIL_SMS_CONNECT_STUB_ENABLED=

# Agent computers. Leave these unset. Without E2B_API_KEY the provider is the fixture.
# COMPUTER_PROVIDER_ENABLED must be the string true before the E2B stub is selected.
# Even then this build does not call E2B. Billy must approve any paid plan first.
# BROWSERBASE_API_KEY is unused in this phase. Do not put a real key here.
# See docs/agent-computers.md.
E2B_API_KEY=
BROWSERBASE_API_KEY=
COMPUTER_PROVIDER_ENABLED=

# Calendars and public booking pages need no new keys and do not turn sending on.
# NEXT_PUBLIC_SITE_URL, when set, is only used to print an absolute /book/... link.

# Optional. Per-send cost. WhatsApp USD defaults are the South Africa card (marketing 0.0379, service 0.0095 after 1,000 free service messages from 2026-10-01). Leave ZAR unset to store USD only.
# Suggested sandbox FX for ZAR estimates. Not a secret. Leave the value blank to store USD only.
# WHATSAPP_USDZAR=16.30
WHATSAPP_MARKETING_USD=
WHATSAPP_SERVICE_USD=
WHATSAPP_USDZAR=
SMS_COST_ZAR=
EMAIL_COST_ZAR=
