NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

CRM_PASSWORD=change-me-company-crm-password
CRM_FORM_SECRET=optional-shared-secret-for-marketing-form

NEXT_PUBLIC_SITE_URL=https://ai-autotech.co.za
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
NEXT_PUBLIC_CLARITY_PROJECT_ID=xxxxxxxxxx
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/ai-autotech/discovery
NEXT_PUBLIC_WHATSAPP_NUMBER=27000000000

STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxx

# WhatsApp auto-responder (Cloud API). See /workspace/whatsapp-bot/GO-LIVE.md
WHATSAPP_TOKEN=system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=any-long-random-string-you-also-paste-into-meta
WHATSAPP_APP_SECRET=meta-app-secret-for-x-hub-signature-256
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_TEST_NUMBERS=27XXXXXXXXX
WHATSAPP_HANDOVER_HOURS=12
# Or, if the number is connected through Kapso (free coexistence route), set these instead of TOKEN/APP_SECRET
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
# LLM, first one found wins: GOOGLE_GENERATIVE_AI_API_KEY (free Gemini) > GROQ_API_KEY > GITHUB_MODELS_TOKEN > Vercel AI Gateway
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
AI_GATEWAY_API_KEY=
WHATSAPP_BOT_MODEL=
# Force a provider (gateway|google|groq|github|openai-compatible) or set a fallback used when the primary errors
WHATSAPP_LLM_PROVIDER=
WHATSAPP_LLM_FALLBACK=
WHATSAPP_DEBOUNCE_MS=3500
# Handover alert emails from aiautotech-alerts@agentmail.to
AGENTMAIL_API_KEY=
